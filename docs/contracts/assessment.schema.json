{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "not_passed",
        "insufficient"
      ]
    },
    "feedback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "quotes": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "evidenceType": {
      "type": "string",
      "enum": [
        "text",
        "self_report",
        "external_unverified"
      ]
    },
    "standardId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "standardVersion": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "outcome",
    "feedback",
    "quotes",
    "evidenceType",
    "standardId",
    "standardVersion"
  ],
  "additionalProperties": false
}
