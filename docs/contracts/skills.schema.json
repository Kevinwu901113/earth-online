{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "earth.plan.v3"
        },
        "goal": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 360
            }
          },
          "required": [
            "title",
            "target",
            "minutes"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "assumptions": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "targetSkillIds": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          }
        },
        "strategy": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "skillIds": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,39}$"
                }
              },
              "approach": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "timing": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "name",
              "skillIds",
              "approach",
              "timing"
            ],
            "additionalProperties": false
          }
        },
        "resources": {
          "maxItems": 15,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "kind": {
                "type": "string",
                "enum": [
                  "app",
                  "book",
                  "questions",
                  "website",
                  "user_material",
                  "self_created"
                ]
              },
              "availability": {
                "type": "string",
                "enum": [
                  "verified_link",
                  "user_provided",
                  "needs_user",
                  "self_created"
                ]
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "question": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "availability",
              "url",
              "locator",
              "purpose",
              "question"
            ],
            "additionalProperties": false
          }
        },
        "tasks": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "skillIds": {
                "minItems": 1,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,39}$"
                }
              },
              "minutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 360
              },
              "stat": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "resourceIds": {
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,39}$"
                }
              },
              "readiness": {
                "type": "string",
                "enum": [
                  "ready",
                  "needs_material"
                ]
              },
              "materialQuestion": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actions": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180
                    },
                    "minutes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 360
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1800
                    }
                  },
                  "required": [
                    "name",
                    "minutes",
                    "detail"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "name",
              "skillIds",
              "minutes",
              "stat",
              "purpose",
              "resourceIds",
              "readiness",
              "materialQuestion",
              "actions"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "goal",
        "summary",
        "assumptions",
        "targetSkillIds",
        "strategy",
        "resources",
        "tasks"
      ],
      "additionalProperties": false
    },
    "treePatch": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "earth.tree.patch.v1"
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "goalId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,39}$"
        },
        "addNodes": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              },
              "icon": {
                "type": "string",
                "enum": [
                  "body",
                  "mind",
                  "action",
                  "sport",
                  "emotion",
                  "focus",
                  "language",
                  "logic",
                  "information",
                  "social",
                  "home",
                  "money",
                  "work",
                  "art",
                  "strength",
                  "stamina",
                  "mobility",
                  "vocabulary",
                  "listening",
                  "reading",
                  "writing",
                  "speaking",
                  "grammar",
                  "practice",
                  "knowledge",
                  "swimming",
                  "running",
                  "cycling",
                  "hiking",
                  "climbing",
                  "yoga",
                  "balance",
                  "recovery",
                  "sleep",
                  "meditation",
                  "nutrition",
                  "firstaid",
                  "cooking",
                  "baking",
                  "coffee",
                  "cleaning",
                  "organizing",
                  "repair",
                  "gardening",
                  "driving",
                  "navigation",
                  "sewing",
                  "budgeting",
                  "saving",
                  "investing",
                  "research",
                  "mathematics",
                  "science",
                  "history",
                  "geography",
                  "memory",
                  "criticalthinking",
                  "planning",
                  "timemanagement",
                  "translation",
                  "coding",
                  "data",
                  "spreadsheet",
                  "database",
                  "security",
                  "engineering",
                  "design",
                  "project",
                  "leadership",
                  "teamwork",
                  "negotiation",
                  "presentation",
                  "teaching",
                  "marketing",
                  "entrepreneurship",
                  "photography",
                  "video",
                  "drawing",
                  "music",
                  "singing",
                  "guitar",
                  "piano",
                  "theater",
                  "storytelling",
                  "craftsmanship"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "domain",
                  "ability"
                ]
              },
              "parentId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "prerequisites": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,39}$"
                }
              },
              "baseline": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "const": "unlit"
                      },
                      "basis": {
                        "type": "string",
                        "const": "unknown"
                      },
                      "quote": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "status",
                      "basis",
                      "quote"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "const": "lit"
                      },
                      "basis": {
                        "type": "string",
                        "const": "self_report"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 600
                      }
                    },
                    "required": [
                      "status",
                      "basis",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "stat": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "milestone": {
                "type": "null"
              }
            },
            "required": [
              "id",
              "name",
              "description",
              "icon",
              "kind",
              "parentId",
              "prerequisites",
              "baseline",
              "stat",
              "milestone"
            ],
            "additionalProperties": false
          }
        },
        "reuseNodeIds": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          }
        },
        "updateNodes": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "baseRevision",
        "requestId",
        "goalId",
        "addNodes",
        "reuseNodeIds",
        "updateNodes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "plan",
    "treePatch"
  ],
  "additionalProperties": false
}
