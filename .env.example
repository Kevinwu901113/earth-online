NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# Optional, explicit proxy rewrite compatibility. Keep empty for normal local/production use.
# Requires external HTTPS APP_ORIGIN, matching Referer and Sec-Fetch-Site: same-origin.
# Example after observing proxy headers: APP_PROXY_ORIGINS=https://localhost:3000
APP_PROXY_ORIGINS=
DATABASE_URL=postgres://earth:local-development-only@127.0.0.1:55432/earth_online
REDIS_URL=redis://127.0.0.1:56379
REGISTRATION_ENABLED=true
SESSION_DAYS=7
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
# Combined thinking + answer cap; incomplete responses never enter settlement.
DSH_REASONING_EFFORT=high
DSH_MAX_TOKENS=16384
DEEPSEEK_API_KEY=
# DSH 0.2 uses DeepSeek Messages transport; configure its supported endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DSH_TIMEOUT_MS=120000
DATA_DIR=var

# Optional real web search. Missing key is shown as unavailable, never simulated.
EXA_API_KEY=

# Local semantic RAG. Run npm run knowledge -- setup, then seed once.
# The embedding model runs on this machine; no additional API key is needed.
RAG_ENABLED=true
RAG_BACKEND=pgvector
RAG_DATA_DIR=var/knowledge
RAG_MODEL=Xenova/bge-small-zh-v1.5
RAG_MODEL_CACHE_DIR=var/models
