{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "earth.plan.v3"
    },
    "goal": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        }
      },
      "required": [
        "title",
        "target",
        "minutes"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "assumptions": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      }
    },
    "targetSkillIds": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,39}$"
      }
    },
    "strategy": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "skillIds": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,39}$"
            }
          },
          "approach": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "timing": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "name",
          "skillIds",
          "approach",
          "timing"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "kind": {
            "type": "string",
            "enum": [
              "app",
              "book",
              "questions",
              "website",
              "user_material",
              "self_created"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "verified_link",
              "user_provided",
              "needs_user",
              "self_created"
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "availability",
          "url",
          "locator",
          "purpose",
          "question"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "skillIds": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,39}$"
            }
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 360
          },
          "stat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "resourceIds": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,39}$"
            }
          },
          "readiness": {
            "type": "string",
            "enum": [
              "ready",
              "needs_material"
            ]
          },
          "materialQuestion": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "actions": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 360
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1800
                }
              },
              "required": [
                "name",
                "minutes",
                "detail"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "skillIds",
          "minutes",
          "stat",
          "purpose",
          "resourceIds",
          "readiness",
          "materialQuestion",
          "actions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "goal",
    "summary",
    "assumptions",
    "targetSkillIds",
    "strategy",
    "resources",
    "tasks"
  ],
  "additionalProperties": false
}