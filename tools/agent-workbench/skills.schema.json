{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "earth.skills.v1"
    },
    "goal": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "criterion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 240
        }
      },
      "required": [
        "title",
        "criterion",
        "minutes"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "assumptions": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "skills": {
      "minItems": 2,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "stat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "prerequisites": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,39}$"
            }
          },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidenceType": {
            "type": "string",
            "enum": [
              "text",
              "external"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "stat",
          "prerequisites",
          "criterion",
          "evidenceType"
        ],
        "additionalProperties": false
      }
    },
    "targetSkillIds": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,39}$"
      }
    },
    "tasks": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "skillIds": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,39}$"
            }
          },
          "minutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 240
          },
          "stat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "actions": {
            "minItems": 2,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "minutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 240
                }
              },
              "required": [
                "name",
                "minutes"
              ],
              "additionalProperties": false
            }
          },
          "steps": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "challenge": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "evidenceType": {
            "type": "string",
            "enum": [
              "text",
              "external"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "skillIds",
          "minutes",
          "stat",
          "actions",
          "steps",
          "criterion",
          "challenge",
          "evidenceType"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "goal",
    "summary",
    "assumptions",
    "skills",
    "targetSkillIds",
    "tasks"
  ],
  "additionalProperties": false
}