{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "skillIds": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,39}$"
      }
    },
    "minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 360
    },
    "stat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "resourceIds": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,39}$"
      }
    },
    "readiness": {
      "type": "string",
      "enum": [
        "ready",
        "needs_material"
      ]
    },
    "materialQuestion": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 360
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          }
        },
        "required": [
          "name",
          "minutes",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "skillIds",
    "minutes",
    "stat",
    "purpose",
    "resourceIds",
    "readiness",
    "materialQuestion",
    "actions"
  ],
  "additionalProperties": false
}