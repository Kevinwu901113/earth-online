{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "icon": {
      "type": "string",
      "enum": [
        "core",
        "vocabulary",
        "listening",
        "reading",
        "writing",
        "speaking",
        "grammar",
        "milestone",
        "practice",
        "knowledge"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "core",
        "domain",
        "ability",
        "milestone"
      ]
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,39}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prerequisites": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,39}$"
      }
    },
    "baseline": {
      "default": {
        "status": "unlit",
        "basis": "unknown",
        "quote": null
      },
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "lit",
            "unlit"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "self_report",
            "unknown"
          ]
        },
        "quote": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 600
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "basis",
        "quote"
      ],
      "additionalProperties": false
    },
    "stat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "milestone": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "framework": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "framework",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "icon",
    "kind",
    "parentId",
    "prerequisites",
    "baseline",
    "stat",
    "milestone"
  ],
  "additionalProperties": false
}